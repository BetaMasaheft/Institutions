               <placeName xml:id="n2" xml:lang="gez">ደብረ፡ ጸራቢ፡ አቡነ፡ እዎስጣቴዎስ፡</placeName>
               <placeName corresp="#n2" xml:lang="en">Dabra Ṣarābi ʾAbuna ʾEwosṭātewos</placeName>
               
               
               <country ref="LOC3010Ethiop">Ethiopia</country>
               <region notBefore="1991" type="RegionalState" ref="LOC5932Tegray">The regional State of Tǝgrāy</region>  
               <settlement ref="LOC6653EastTegray" type="zone" when="2026-05-15">East Tǝgrāy zone</settlement>
               <settlement ref="LOC6653EastTegray" type="warada" notBefore="2020-01-01"> waradā Ḍǝrāʿ Wambartā</settlement>
               <settlement when="2026-05-01" ref="LOC7498DabraBerhan" type="tabiya">ṭābiyā Dabra Bǝrhān</settlement>
               <settlement when="2024-03-15" ref="LOC7499DabraSarabi" type="qushet">sub kebele Dabra Ṣarābi</settlement>
              
               <location>
                  <geo>13.651111 39.425056</geo>
                  <height unit="m">1816.0</height>
               </location>
               <note>
                  <date type="foundation" notBefore="1300" notAfter="1399">14th century.</date>
                  <ab type="history">Gadām. According to the local tradition, the monastery was established by 
                     ʾabbā Bǝnyāmin, a disciple of ʾEwosṭātewos, in the time of 
                     the reign of <persName ref="PRS1854Amdase">ʿAmda Ṣǝyon I</persName>, but this 
                     account is inconsistent. 
                  </ab>
                  <ab type="tabot">
                     <measure quantity="3">3</measure> main  tābots,                              
                     <persName ref="PRS6819Mary" type="tabot">Mary</persName>. 
                     <persName ref="PRS3934Ewostate" type="tabot">ʾabuna ʾEwosṭātewos</persName>, 
                     and <persName ref="PRS3249Cyriacus" type="tabot">Cyriacus</persName>.
                  </ab>
                    <ab type="description">86 manuscripts were inventarized in <date>May 2026</date>
                     by Hailay Atsbha (Tigray Tourism and Culture Bureau) and 
                     Hagos Gebremariam (Department of Sociology, Adigrat University). The main feast 
                     is celebrated on 18 Maskaram (ʾabuna ʾEwosṭātewos). Ca. 40 servants were in the monastery 
                  in May 2026.</ab>
               </note>
      
            </place>
